# Salin ke .env.local (lokal) atau isi di Vercel → Settings → Environment Variables.
# Tanpa kedua nilai VITE_* di bawah, fitur akun tidak tampil dan situs bekerja seperti biasa.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://gsjpkjolxielseltvhnn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------- hanya server (AI & pemantauan situs)
# JANGAN diberi awalan VITE_ dan jangan di-commit. Isi di Vercel → Settings → Environment Variables.
# SUPABASE_URL=https://gsjpkjolxielseltvhnn.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Penyedia AI — pilih satu:
# (a) gratis, berformat OpenAI (mis. Google Gemini dari AI Studio)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=
# (b) Anthropic API (bawaan bila AI_PROVIDER kosong)
# ANTHROPIC_API_KEY=
# (c) Amazon Bedrock
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Opsional: AI_MODEL (bawaan claude-sonnet-5-5 / anthropic.claude-sonnet-5-5), AI_EFFORT (bawaan medium)
